<!DOCTYPE html>
<html>
<head>
    <title>The Page Hive</title>
    <link rel="stylesheet" href="/books.css">
    <link rel="stylesheet" href="logo.css">
</head>
<body>
  <header class="site-header">
    <img src="/logo.png" class="site-logo" alt="Logo">
</header>

    <!-- searching for books online -->
    <form id="searchForm">
        <input type="text" id="searchTitle" placeholder="Book Title">
        <input type="text" id="searchAuthor" placeholder="Author">
        <button type="submit">Search</button>
    </form>
     
    <div class="main-wrapper">
        <div class="section-box">
            <h3>Book Catalog</h3>
            <ul id="catalog"></ul>
        </div>

        <div class="section-box">
            <h3>Your Borrowed Books</h3>
            <ul id="shelf"></ul>
        </div>
    </div>



   <a href="/logout" class="logout-link">Logout</a>

    

   <!-- passing borrowed books to the user for the server -->
    <script>
        const borrowedBooksFromServer = <%- JSON.stringify(borrowedBooks) %>;
    </script>


    <script src="/app.js"></script>
</body>
</html>
